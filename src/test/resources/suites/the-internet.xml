<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  the-internet.herokuapp.com: otomasyonda "zor" sayılan senaryolar. Aynı framework, ikinci bir uygulama.
  Çalıştır: mvn test -Dsuite=the-internet
-->
<suite name="The Internet - Hard scenarios" verbose="1">
    <listeners>
        <listener class-name="com.servet.framework.listeners.TestListener"/>
        <listener class-name="com.servet.framework.listeners.RetryTransformer"/>
        <listener class-name="com.servet.framework.listeners.ExtentReportListener"/>
        <listener class-name="com.servet.framework.listeners.AllureEnvironmentListener"/>
    </listeners>
    <test name="The Internet">
        <packages>
            <package name="com.servet.theinternet.tests"/>
        </packages>
    </test>
</suite>
